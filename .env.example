# Password for /add. Set it in Vercel → Settings → Environment Variables for production.
ADMIN_PASSWORD=

# Filled in automatically on Vercel once you connect the stores (Storage tab).
# Leave empty locally to use the in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Weekly email (api/digest.js, run by the cron in vercel.json). Only needed on Vercel.
# BUTTONDOWN_API_KEY: Buttondown → Settings → API. CRON_SECRET: any long random string;
# Vercel sends it with each cron run, and without it nothing can trigger a send.
BUTTONDOWN_API_KEY=
CRON_SECRET=
